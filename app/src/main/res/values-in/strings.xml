    <!-- About Screen Details -->
    <string name="about_version">Versi %s</string>
    <string name="about_build_target">Build %1$d • Target SDK %2$d (Android 15)</string>
    <string name="about_min_sdk">Min SDK %d (Marshmallow)</string>
    <string name="about_subtitle">Precision Mock Geolocation &amp; Geofence Simulator</string>
    <string name="about_description">GPS Mirage — Cara termudah untuk menguji dan mengelola mock location di Android.</string>
    <string name="about_app_purpose_title">Tujuan Aplikasi</string>
    <string name="about_app_purpose_content">Aplikasi pengujian geolokasi dan simulasi fake GPS berbasis radius acuan (geofence) untuk riset, evaluasi batas wilayah terkontrol, serta perlindungan privasi.</string>
    <string name="about_features_title">Fitur Unggulan Sistem:</string>
    <string name="about_feature_1">Batas simulasi geofence akurat dengan titik acuan Center Anchor.</string>
    <string name="about_feature_2">Pengujian fungsionalitas lokasi tanpa berpindah tempat fisik.</string>
    <string name="about_feature_3">Preset parameter akurasi, ketinggian, kecepatan, dan bearing.</string>
    <string name="about_feature_4">Otomasi multi-stage map rewind, generator titik, dan reminder.</string>
    <string name="about_developer_title">Developer di Baliknya</string>
    <string name="about_developer_role">Android Software Engineer</string>
    <string name="about_developer_desc">Aplikasi ini dirancang dengan Clean Architecture dan Material 3, mengintegrasikan mesin OpenStreetMap (OSMDroid), Dagger Hilt, dan Room Database dengan standar kompatibilitas mundur penuh dari Android 6.0 Marshmallow hingga Android 15.</string>
    <string name="about_security_title">Keamanan &amp; Privasi Data</string>
    <string name="about_security_desc">GPS Mirage beroperasi 100% lokal pada perangkat pengguna (client-side execution). Seluruh data titik koordinat tersimpan, folder, log histori, dan profil nilai default disimpan murni di database internal SQLite perangkat Anda dan tidak dikirim ke server pihak ketiga mana pun.</string>
    <string name="about_tag_offline">Offline-First</string>
    <string name="about_copyright">© 2026 Dhikadityre • All Rights Reserved</string>

