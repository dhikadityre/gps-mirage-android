    <!-- About Screen Details -->
    <string name="about_version">Version %s</string>
    <string name="about_build_target">Build %1$d • Target SDK %2$d (Android 15)</string>
    <string name="about_min_sdk">Min SDK %d (Marshmallow)</string>
    <string name="about_subtitle">Precision Mock Geolocation &amp; Geofence Simulator</string>
    <string name="about_description">GPS Mirage — The simplest way to test and manage Android mock locations.</string>
    <string name="about_app_purpose_title">Application Purpose</string>
    <string name="about_app_purpose_content">A geolocation testing and geofence-based mock GPS simulator designed for research, controlled perimeter evaluations, and privacy protection.</string>
    <string name="about_features_title">Key System Features:</string>
    <string name="about_feature_1">Accurate geofence simulation boundaries with Center Anchor reference points.</string>
    <string name="about_feature_2">Location functionality testing without physically moving.</string>
    <string name="about_feature_3">Configurable presets for accuracy, altitude, speed, and bearing.</string>
    <string name="about_feature_4">Multi-stage map rewind, coordinate generator, and automated reminders.</string>
    <string name="about_developer_title">Developer Behind</string>
    <string name="about_developer_role">Android Software Engineer</string>
    <string name="about_developer_desc">Engineered with Clean Architecture and Material 3, integrating OpenStreetMap (OSMDroid), Dagger Hilt, and Room Database with full backward compatibility from Android 6.0 Marshmallow to Android 15.</string>
    <string name="about_security_title">Data Security &amp; Privacy</string>
    <string name="about_security_desc">GPS Mirage operates 100% locally on user device (client-side execution). All stored coordinate points, folders, history logs, and default profile values are strictly saved in device local SQLite database and never transmitted to external third-party servers.</string>
    <string name="about_tag_offline">Offline-First</string>
    <string name="about_copyright">© 2026 Dhikadityre • All Rights Reserved</string>

